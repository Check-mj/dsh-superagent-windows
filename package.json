{
  "name": "dsh-superagent",
  "author": "DeepSeek Harness Team <team@dsh.dev>",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "description": "DSH-Superagent —— DeepSeek 团队最新的 SuperAgent 在 DSH 工具里的 Windows 深度适配版（官方 dsh-superagent-prototype 的 fork，非官方产品）。它把 GitHub 仓库（issue/PR/评论/CI）与可选的飞书群聊变成持续的事件源：获授权的请求变成工单，在各自隔离的 DSH 会话里执行，结果回贴到原处；面板管触发、评估、执行与设置，桌面应用提供一键安装、多实例与故障自愈，并按官方设计补齐了上游尚未实现的 Watchdog 控制回路与 Router 分片。上游：https://github.com/deepseek-ai/dsh-superagent-prototype（MIT，Copyright (c) 2026 DeepSeek Harness Team）；本构建：https://github.com/Check-mj/dsh-superagent-windows",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./github-watch": "./lib/github-watch.js",
    "./feishu-watch": "./lib/feishu-watch.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "prompts",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-check.ps1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  },
