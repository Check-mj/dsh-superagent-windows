  "private": true,
  "description": "\u5728 Windows \u4e0a\u8fd0\u884c\u7684 Super-agent\uff1a\u76d1\u542c\u5355\u4e2a GitHub \u4ed3\u5e93\uff0c\u628a\u83b7\u6388\u6743\u7684\u8bf7\u6c42\u8f6c\u4e3a\u5de5\u5355\uff0c\u5728\u5404\u81ea\u7684 DSH \u4f1a\u8bdd\u4e2d\u6267\u884c\u5e76\u628a\u7ed3\u679c\u56de\u8d34\u5230\u539f\u5904\u3002\u672c\u6784\u5efa\u5728\u5b98\u65b9\u539f\u578b\u4e4b\u4e0a\u52a0\u4e86 Windows \u79fb\u690d\u3001\u684c\u9762\u5e94\u7528\u3001\u591a\u5b9e\u4f8b\u7ba1\u7406\u3001Watchdog \u63a7\u5236\u56de\u8def\u4e0e Router \u5206\u7247\u3002\u4e0a\u6e38\u4ee3\u7801\uff1ahttps://github.com/deepseek-ai/dsh-superagent-prototype\uff1b\u672c\u6784\u5efa\uff08\u6784\u5efa\u4ed3\u5e93\uff09\uff1ahttps://github.com/Check-mj/dsh-superagent-windows",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./github-watch": "./lib/github-watch.js",
    "./feishu-watch": "./lib/feishu-watch.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "prompts",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  },
