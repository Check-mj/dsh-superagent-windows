  "version": "0.1.0",
  "private": true,
  "description": "DSH-Superagent \u2014\u2014 dsh super agent \u7684 Windows \u6df1\u5ea6\u9002\u914d\u7248\uff08\u5b98\u65b9 dsh-superagent-prototype \u7684 fork\uff0c\u975e\u5b98\u65b9\u4ea7\u54c1\uff09\u3002\u5b83\u628a GitHub \u4ed3\u5e93\uff08issue/PR/\u8bc4\u8bba/CI\uff09\u4e0e\u53ef\u9009\u7684\u98de\u4e66\u7fa4\u804a\u53d8\u6210\u6301\u7eed\u7684\u4e8b\u4ef6\u6e90\uff1a\u83b7\u6388\u6743\u7684\u8bf7\u6c42\u53d8\u6210\u5de5\u5355\uff0c\u5728\u5404\u81ea\u9694\u79bb\u7684 DSH \u4f1a\u8bdd\u91cc\u6267\u884c\uff0c\u7ed3\u679c\u56de\u8d34\u5230\u539f\u5904\uff1b\u9762\u677f\u7ba1\u89e6\u53d1\u3001\u8bc4\u4f30\u3001\u6267\u884c\u4e0e\u8bbe\u7f6e\uff0c\u684c\u9762\u5e94\u7528\u63d0\u4f9b\u4e00\u952e\u5b89\u88c5\u3001\u591a\u5b9e\u4f8b\u4e0e\u6545\u969c\u81ea\u6108\uff0c\u5e76\u6309\u5b98\u65b9\u8bbe\u8ba1\u8865\u9f50\u4e86\u4e0a\u6e38\u5c1a\u672a\u5b9e\u73b0\u7684 Watchdog \u63a7\u5236\u56de\u8def\u4e0e Router \u5206\u7247\u3002\u4e0a\u6e38\uff1ahttps://github.com/deepseek-ai/dsh-superagent-prototype\uff08MIT\uff0cCopyright (c) 2026 DeepSeek Harness Team\uff09\uff1b\u672c\u6784\u5efa\uff1ahttps://github.com/Check-mj/dsh-superagent-windows",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./github-watch": "./lib/github-watch.js",
    "./feishu-watch": "./lib/feishu-watch.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "prompts",
    "skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "release:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release-check.ps1"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.1-alpha.2"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-alpha.2",
